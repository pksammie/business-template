rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function onlyChangedFields(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(allowed);
    }

    /* ---------------- ADMINS ---------------- */
    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow write: if false;
    }

    /* ---------------- USERS ---------------- */
    match /users/{uid} {
      allow read, write: if false;

      match /cart/{cartItemId} {
        allow read, write: if isOwner(uid);
      }

      match /cart_backups/{backupId} {
        allow read, write: if isOwner(uid);
      }
      
    }
    
    match /{path=**}/cart/{cartItemId} {
  allow read: if isAdmin();
}

    /* ---------------- PRODUCTS ---------------- */
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || (isSignedIn() && onlyChangedFields(
              ['reviewCount', 'totalRating', 'averageRating']
           ))
        || (isSignedIn() && onlyChangedFields(['isEditing'])
              && request.resource.data.isEditing == false);
    }

    /* ---------------- REVIEWS ----------------
       NOTE: the approval threshold below was changed from
       `rating > 1` to `rating > 2` so that BOTH 1-star and 2-star
       reviews require admin approval (previously only 1-star did).
       This must always match the threshold used in review.js and
       decision-page.js's submitEditReview -- if you change one,
       change all three. */
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn()
        && reviewId == request.resource.data.orderId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.approved == (request.resource.data.rating > 2)
        && request.resource.data.featured == false
        && !("adminReply" in request.resource.data);

      allow update: if isAdmin()
        // Liking/unliking a review only ever touches these three fields.
        // likeNotifiedBy was added so we can permanently remember "this
        // user already triggered a like-notification for this review",
        // which is what stops repeat like/unlike spam from re-notifying
        // the review's author every time.
        || (isSignedIn() && onlyChangedFields(['likes', 'likedBy', 'likeNotifiedBy']))
        || (isOwner(resource.data.userId)
            && onlyChangedFields(['reviewText', 'rating', 'edited', 'approved'])
            && request.resource.data.approved == (request.resource.data.rating > 2));

      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    /* ---------------- CART_RESERVATIONS (orders) ---------------- */
    match /cart_reservations/{orderId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAdmin()
        || (isOwner(resource.data.userId)
            && onlyChangedFields(['reviewSubmitted']));

      allow delete: if isAdmin();
    }

    /* ---------------- ORDERS (legacy/unused collection) ---------------- */
    match /orders/{orderId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    /* ---------------- COMPLAINTS ---------------- */
    match /complaints/{complaintId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "Open";

      allow update, delete: if isAdmin();
    }

    /* ---------------- USER_NOTIFICATIONS ---------------- */
    match /user_notifications/{notifId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);

      allow create: if isAdmin()
        || (isSignedIn()
            && request.resource.data.type == "review_liked"
            && request.resource.data.userId != request.auth.uid);

      allow update: if isOwner(resource.data.userId)
        && onlyChangedFields(['read']);

      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    /* ---------------- ADMIN_NOTIFICATIONS ---------------- */
    match /admin_notifications/{notifId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    /* ---------------- SUPPORT FAQ ---------------- */
    match /store_faq/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /store_knowledge/{id} {
    allow read: if true;
    allow write: if isAdmin();
}

    /* ---------------- SUPPORT BOT UNANSWERED QUESTIONS ---------------- */
    match /support_unanswered_questions/{id} {

    allow create: if true;

    allow read: if isAdmin();

    allow update, delete: if isAdmin();

}

    /* ---------------- STOCK_NOTIFICATIONS ----------------
       FIX: previously only admins could read this collection at all.
       decision-page.js's "Notify Me" button needs to read a customer's
       OWN pending requests first (to avoid creating duplicates), and
       that read was being rejected with "Missing or insufficient
       permissions" for every non-admin user -- which silently broke
       the whole back-in-stock flow for real customers (it only ever
       "worked" when tested from an admin account). Owners can now also
       read their own requests; only admins can update (mark notified). */
    match /stock_notifications/{id} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow update: if isAdmin();
    }
  }
}
